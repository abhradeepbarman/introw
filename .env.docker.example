# Copy to .env.docker and fill in the values:
#
#   cp .env.docker.example .env.docker
#   docker compose -f docker.compose.yml up --build
#

# --- Runtime mode ---
NODE_ENV=

# --- Postgres (replaces Supabase inside the stack) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
DIRECT_URL=

# --- URLs (host-facing, so the browser can reach them) ---
APP_URL=
BUN_PUBLIC_API_BASE_URL=
GOOGLE_AUTH_REDIRECT_URI=

# --- Carried over from apps/server/.env ---
CRAWLBASE_PROXY_HOST=
CRAWLBASE_PROXY_KEY=
CRAWLBASE_PROXY_PORT=
OPENAI_API_KEY=
GEMINI_API_KEY=
ACCESS_SECRET=
REFRESH_SECRET=
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
IMAGEKIT_PRIVATE_KEY=
RESEND_API_KEY=
EMAIL_FROM=
GITHUB_TOKEN=
