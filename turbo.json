{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "APP_URL",
    "BUN_PUBLIC_API_URL",
    "BUN_PUBLIC_API_BASE_URL",
    "CRAWLBASE_PROXY_HOST",
    "CRAWLBASE_PROXY_KEY",
    "CRAWLBASE_PROXY_PORT",
    "DATABASE_URL",
    "DIRECT_URL",
    "OPENAI_API_KEY",
    "GEMINI_API_KEY",
    "ACCESS_SECRET",
    "REFRESH_SECRET",
    "GOOGLE_AUTH_CLIENT_ID",
    "GOOGLE_AUTH_CLIENT_SECRET",
    "GOOGLE_AUTH_REDIRECT_URI",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "STRIPE_STARTER_PRICE_ID",
    "IMAGEKIT_PRIVATE_KEY",
    "RESEND_API_KEY",
    "EMAIL_FROM"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:deploy": {
      "cache": false
    }
  }
}
