FROM oven/bun:1.2.21

WORKDIR /app

COPY package.json bun.lock ./
COPY apps/server/package.json apps/server/
COPY apps/web/package.json apps/web/
COPY packages/ai/package.json packages/ai/
COPY packages/common/package.json packages/common/
COPY packages/db/package.json packages/db/
COPY packages/eslint-config/package.json packages/eslint-config/
COPY packages/typescript-config/package.json packages/typescript-config/

RUN bun install --frozen-lockfile

COPY . .

ENV NODE_ENV=production
ENV PORT=8000

EXPOSE 8000

USER bun

# Migrations run before the app boots: startQueue() has pg-boss create its own
# schema on import, so the database has to be reachable and current first.
# prisma.config.ts resolves the datasource from DIRECT_URL.
CMD ["sh", "-c", "cd packages/db && bunx prisma migrate deploy && cd /app && bun apps/server/src/index.ts"]
