{
  "name": "server",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "dev": "bun run --watch --hot ./src/index.ts",
    "build": "bun build --outdir=dist --minify ./src/index.ts",
    "start": "bun run build --outdir=dist --minify ./src/index.ts && bun run dist/index.js"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "latest",
    "eslint": "^9.39.1",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
