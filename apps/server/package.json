{
  "name": "server",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "dev": "bun --watch --env-file=.env ./src/index.ts",
    "build": "bun build --target=bun --outdir=dist --minify ./src/index.ts",
    "start": "bun run build && bun --env-file=.env ./dist/index.js"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "latest",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.1",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "@imagekit/nodejs": "^7.10.0",
    "@repo/common": "workspace:*",
    "@repo/db": "workspace:*",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "resend": "^6.18.1",
    "stripe": "^22.4.0",
    "winston": "^3.19.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  }
}
